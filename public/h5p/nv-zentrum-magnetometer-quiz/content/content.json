text":"<p>Kupferatom</p>\n"},"subContentId":"9c0e0dfb-1e34-4ecf-bef7-59115cfc48b0","metadata":{"contentType":"Text","license":"U","title":"Untitled Text"}},"alwaysDisplayComments":false,"backgroundOpacity":0,"displayAsButton":false,"buttonSize":"big","goToSlideType":"specified","invisible":false,"solution":""},{"x":48.888888888888886,"y":59.26043677253789,"width":9.401943573667712,"height":7.430708641914151,"action":{"library":"H5P.AdvancedText 1.1","params":{"text":"<p>Diamant</p>\n"},"subContentId":"868defbb-0309-4150-89fe-8ec8fd655467","metadata":{"contentType":"Text","license":"U","title":"Untitled Text"}},"alwaysDisplayComments":false,"backgroundOpacity":0,"displayAsButton":false,"buttonSize":"big","goToSlideType":"specified","invisible":false,"solution":""},{"x":48.888888888888886,"y":66.57654007778949,"width":10.9717868338558,"height":9.283555841775446,"action":{"library":"H5P.AdvancedText 1.1","params":{"text":"<p>Radioaktive Strahlung</p>\n"},"subContentId":"c70caef0-2c8d-4ea9-ba0d-d13398db609a","metadata":{"contentType":"Text","license":"U","title":"Untitled Text"}},"alwaysDisplayComments":false,"backgroundOpacity":0,"displayAsButton":false,"buttonSize":"big","goToSlideType":"specified","invisible":false,"solution":""}],"slideBackgroundSelector":{"imageSlideBackground":{"path":"images/imageSlideBackground-6ad0e977ba1e2.png","mime":"image/png","copyright":{"license":"U"},"width":1600,"height":800}}},{"elements":[{"x":62.695924764890286,"y":24.769028806380504,"width":32.168338557993735,"height":61.33244990463924,"action":{"library":"H5P.Image 1.1","params":{"decorative":false,"contentName":"Image","expandImage":"Expand Image","minimizeImage":"Minimize Image","file":{"path":"images/image-eHZWKAkS.png","mime":"image/png","copyright":{"license":"U"},"width":1899,"height":1833},"alt":"NV-Zentrum im Gitter","title":"NV-Zentrum im Gitter"},"subContentId":"a7382bdf-2b4c-4ebb-976c-cb7471a69380","metadata":{"contentType":"Image","license":"U","title":"Untitled Image"}},"alwaysDisplayComments":false,"backgroundOpacity":0,"displayAsButton":false,"buttonSize":"big","goToSlideType":"specified","invisible":false,"solution":""},{"x":6.269592476489028,"y":34.05741460877319,"width":48.58934169278997,"height":39.99826616798355,"action":{"library":"H5P.AdvancedText 1.1","params":{"text":"<p>Ein NV-Zentrum besteht also aus einem Stickstoff (<strong>N</strong>itrogen)-Atom und einer Leerstelle (<strong>V</strong>acancy).</p>\n\n<p>Im Diamant gehen normalerweise je ein Elektron zweier benachbarter Kohlenstoffatome eine Bindung (grau) ein. Bei der Fehlstelle fehlt ein Kohlenstoffatom. Es liegen Elektronen vor (blau) die kein Teil einer Bindung sind.</p>\n"},"subContentId":"4b8e1678-864d-4300-a6ad-3ed93b0ce1ef","metadata":{"contentType":"Text","license":"U","title":"Untitled Text"}},"alwaysDisplayComments":false,"backgroundOpacity":0,"displayAsButton":false,"buttonSize":"big","goToSlideType":"specified","invisible":false,"solution":""}],"slideBackgroundSelector":{"imageSlideBackground":{"path":"images/imageSlideBackground-6ad0e98a796b0.png","mime":"image/png","copyright":{"license":"U"},"width":1600,"height":800}}},{"elements":[{"x":5.553039629629629,"y":25.60636156838057,"width":68.51851851851852,"height":73.16103305251592,"action":{"library":"H5P.SingleChoiceSet 1.11","params":{"choices":[{"subContentId":"42a6ca2f-5afc-43d4-9638-b5d30e20d3ae","question":"<p>In welcher Spalte (Hauptgruppe) steht Kohlenstoff im Periodensystem, oder anders gefragt wie viele äußere Elektronen bringt ein Kohlenstoff für chemische Bindungen mit?</p>","answers":["<p>4</p>\n","<p>2</p>\n","<p>3</p>\n","<p>9</p>\n"]},{"subContentId":"47396ee8-676d-417d-9261-b7fca300125f","question":"<p>In welcher Spalte (Hauptgruppe) steht Stickstoff oder anders gefragt wie viele (Valenz-)Elektronen bringt Stickstoff mit?</p>\n","answers":["<p>5</p>\n","<p>3</p>\n","<p>8</p>\n","<p>7</p>\n"]}],"overallFeedback":[{"from":0,"to":100}],"behaviour":{"autoContinue":true,"timeoutCorrect":2000,"timeoutWrong":3000,"soundEffectsEnabled":true,"enableRetry":true,"enableSolutionsButton":true,"passPercentage":100},"l10n":{"nextButtonLabel":"Next question","showSolutionButtonLabel":"Show solution","retryButtonLabel":"Retry","solutionViewTitle":"Solution list","correctText":"Correct!","incorrectText":"Incorrect!","shouldSelect":"Should have been selected","shouldNotSelect":"Should not have been selected","muteButtonLabel":"Mute feedback sound","closeButtonLabel":"Close","slideOfTotal":"Slide :num of :total","scoreBarLabel":"You got :num out of :total points","solutionListQuestionNumber":"Question :num","a11yShowSolution":"Show the solution. The task will be marked with its correct solution.","a11yRetry":"Retry the task. Reset all responses and start the task over again."}},"subContentId":"5d57a889-7e7d-4dbf-bbc3-50f373bd9d5b","metadata":{"contentType":"Single Choice Set","license":"U","title":"Untitled Single Choice Set"}},"alwaysDisplayComments":false,"backgroundOpacity":0,"displayAsButton":false,"buttonSize":"big","goToSlideType":"specified","invisible":false,"solution":""}],"slideBackgroundSelector":{"imageSlideBackground":{"path":"images/imageSlideBackground-6ad0e9a008032.png","mime":"image/png","copyright":{"license":"U"},"width":1600,"height":800}}},{"elements":[{"x":3.134796238244514,"y":37.153543209570756,"width":61.12852664576803,"height":55.730314814356134,"action":{"library":"H5P.AdvancedText 1.1","params":{"text":"<p>In die Leerstelle ragen vier Elektronen (blau) der vier benachbarten Atome hinein. Eines davon ist aber ein Stickstoffatom. Dieses hat noch ein zusätzliches Elektron, das nicht in die bisherige Gitterstruktur passt.</p>\n\n<p>Das Elektron bleibt dann um das NV-Zentrum herum eingesperrt, so ähnlich wie eine Schwingung bzw. Welle auf einer Geigensaite. Diese Vorstellung entspringt der Quantenmechanik:</p>\n\n<p>So wie auf ein und derselben Geigensaite ein Ton und dessen Obertöne (quietschen) schwingen können, so kann das eingesperrte Elektron auch Schwingungen verschiedener aber bestimmter Frequenzen ausführen. Diese Schwingungen werden sogenannten Zuständen zugeordnet.</p>\n"},"subContentId":"dd0c913d-af5e-4b63-929b-982bcd8d1f12","metadata":{"contentType":"Text","license":"U","title":"Untitled Text"}},"alwaysDisplayComments":false,"backgroundOpacity":0,"displayAsButton":false,"buttonSize":"big","goToSlideType":"specified","invisible":false,"solution":""},{"x":68.96551724137932,"y":15.480643003987815,"width":28.213166144200628,"height":83.5954722215342,"action":{"library":"H5P.Video 1.6","params":{"visuals":{"fit":true,"controls":true},"playback":{"autoplay":false,"loop":true},"l10n":{"name":"Video","loading":"Video player loading...","noPlayers":"Found no video players that supports the given video format.","noSources":"Video is missing sources.","aborted":"Media playback has been aborted.","networkFailure":"Network failure.","cannotDecode":"Unable to decode media.","formatNotSupported":"Video format not supported.","mediaEncrypted":"Media encrypted.","unknownError":"Unknown error.","invalidYtId":"Invalid YouTube ID.","unknownYtId":"Unable to find video with the given YouTube ID.","restrictedYt":"The owner of this video does not allow it to be embedded."},"sources":[{"path":"videos/video-L98tidnU.mp4","mime":"video/mp4","copyright":{"license":"U"}}]},"subContentId":"9eb1edc3-0c1c-4987-bc8d-67bac61f8da3","metadata":{"contentType":"Video","license":"U","title":"eingesperrte, scheinbar stehende Welle"}},"alwaysDisplayComments":false,"backgroundOpacity":0,"displayAsButton":false,"buttonSize":"big","goToSlideType":"specified","invisible":false,"solution":""},{"x":3.134796238244514,"y":22.911351645901966,"width":63.7269592476489,"height":39.99826616798355,"action":{"library":"H5P.AdvancedText 1.1","params":{"text":"<h3>Eingesperrte Elektronen in der Quantenmechanik</h3>\n"},"subContentId":"8ca58cb2-a8f5-4da7-82cd-ac79fcdc0962","metadata":{"contentType":"Text","license":"U","title":"Untitled Text"}},"a